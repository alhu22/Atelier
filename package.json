{
  "name": "atelier",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm start",
    "prestart": "npm run build",
    "start": "python3 -u server.py",
    "dev:api": "python3 -u server.py",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test:projects": "python3 -m unittest discover -s tests && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "jszip": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "react-router-dom": "^7.18.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "postcss-selector-parser": "^7.1.6"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "playwright": "^1.64.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
